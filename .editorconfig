root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.lua]
indent_style = space
indent_size = 2

[*.yml]
indent_style = space
indent_size = 2

# Two trailing spaces are a deliberate Markdown line break -- don't strip them.
[*.md]
trim_trailing_whitespace = false
